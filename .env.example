# 复制为 .env 后填写。.env 不要提交到仓库。

# 服务端口
PORT=5173

# 图像生成服务商：mock | doubao | dashscope | fal
# mock 不需要任何 key，可在本地完整跑通流程
IMAGE_PROVIDER=mock

# --- 火山方舟（豆包 Seedream / SeedEdit）---
ARK_API_KEY=
# Flash 优先；只有 Flash 不可用时才尝试 Pro。两个模型都需在方舟账号开通。
ARK_MODEL=doubao-seedream-5-0-flash-260915,doubao-seedream-5-0-pro-260628

# --- 阿里云百炼（通义万相）---
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=wanx2.1-imageedit

# --- fal.ai（Flux Kontext，改风格保身份能力较强）---
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext

# 同时进行的生成任务数上限（超出自动排队）
MAX_CONCURRENT_JOBS=2

# 是否把用户上传的原图落盘。
# 默认 false：原图只在内存中流转，生成结束即释放，不写磁盘。
SAVE_UPLOADS=false

